# ==============================================
# SITUNEO DIGITAL - Environment Configuration
# PT SITUNEO DIGITAL SOLUSI INDONESIA
# NIB: 1401250064281
# ==============================================

# Application
APP_NAME="SITUNEO DIGITAL"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/situneo-digital/public

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=situneo_digital
DB_USERNAME=root
DB_PASSWORD=

# Email Configuration (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@situneo.com
MAIL_FROM_NAME="SITUNEO DIGITAL"

# Session Configuration
SESSION_LIFETIME=120
SESSION_DRIVER=file

# Security
BCRYPT_COST=12
CSRF_TOKEN_NAME=csrf_token
SESSION_NAME=situneo_session

# Company Information
COMPANY_NAME="PT SITUNEO DIGITAL SOLUSI INDONESIA"
COMPANY_NIB=1401250064281
COMPANY_EMAIL=info@situneo.com
COMPANY_PHONE=+62-xxx-xxxx-xxxx

# Pricing Configuration (in Rupiah)
PRICE_BELI_PER_PAGE=350000
PRICE_SEWA_PER_MONTH=150000
SEWA_MIN_MONTHS=3

# Commission Tiers (%)
COMMISSION_PARTNER_TIER1=30
COMMISSION_PARTNER_TIER2=40
COMMISSION_PARTNER_TIER3=50
COMMISSION_PARTNER_TIER4=55
COMMISSION_SPV=10
COMMISSION_MANAGER=5

# File Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx

# Timezone
APP_TIMEZONE=Asia/Jakarta

# Locale
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
